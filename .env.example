# Copy to .env.development or .env.production and adjust.

# Local SQLite file path (development and non-Turso production)
DATABASE_PATH=./data/shareboard.sqlite

# Session cookie signing secret — use a long random string in production
AUTH_SECRET=change-me-to-a-long-random-string

# Turso (production on Vercel — libSQL over HTTPS)
# Create a database at https://turso.tech then:
#   turso db show <name> --url
#   turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-database-name-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
