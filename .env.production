# Session cookie signing secret (set a strong value on Vercel)
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Turso (used when NODE_ENV=production and both vars are set)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: local file DB for `npm run start` without Turso (development uses .env.development)
DATABASE_PATH=./data/shareboard.prod.sqlite
